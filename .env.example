# Copy to .env and fill in what you use. `ajaanai secrets-sync` uploads it to Modal.
# Every setting in src/ajaanai/config.py can be set here (upper-case name).

# --- Keys ----------------------------------------------------------------------------------
ANTHROPIC_API_KEY=            # dataset question synthesis + eval judge
ELEVENLABS_API_KEY=           # phone agent + default transcription (Scribe)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # E.164, e.g. +14155550123 (or use `ajaanai phone --search/--buy`)
HF_TOKEN=                     # downloading gated models / pushing your fine-tune (optional)
ENDPOINT_BEARER_SECRET=       # generated by `ajaanai secrets-sync` if empty
ENDPOINT_URL=                 # from `ajaanai endpoints` after deploying

# --- Transcription: pick a provider, set its key -------------------------------------------
TRANSCRIBE_PROVIDER=elevenlabs   # elevenlabs | openai | deepgram | assemblyai | modal_whisper (no key)
# TRANSCRIBE_MODEL=              # provider default if unset (scribe_v2, gpt-4o-transcribe, nova-3, universal, large-v3-turbo)
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
# TRANSCRIBE_GRACE_DAYS=21       # wait for an official transcript before paying for ASR
# RECHECK_DAYS=120               # keep re-checking recent talks for official transcripts
# EVENING_CRON=0 9 * * *         # daily evening-talk run (UTC); redeploy after changing

# --- Model (swappable) -----------------------------------------------------------------------
MODEL_PROFILE=qwen3.5-27b        # see `ajaanai models`; "generic" + MODEL_ID for any HF model
# MODEL_ID=                      # override weights, e.g. Qwen/Qwen3.5-9B
# TRAIN_GPU= / SERVE_GPU=        # override the profile's GPUs

# Training backend: modal (LoRA on open weights) | openai | together
TRAIN_BACKEND=modal
# HOSTED_BASE_MODEL=             # for openai/together, e.g. gpt-4.1-mini-2025-04-14
# TOGETHER_API_KEY=
# HF_OUTPUT_REPO=                # optional private repo for merged weights

# Serving backend: modal_vllm (our GPU) | openai_compatible (any hosted / local OpenAI-style API)
LLM_BACKEND=modal_vllm
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# UPSTREAM_MODEL=ft:...
# UPSTREAM_API_KEY=
# SERVE_MIN_CONTAINERS=0         # 1 = always warm (~$2/h on L40S); 0 = scale to zero
# SERVE_SCALEDOWN_WINDOW_S=600

# --- Conversation behaviour --------------------------------------------------------------------
# REASONING_MODE=auto            # off | on | auto (think only on substantive questions)
# REASONING_BUDGET_TOKENS=1024
# FILLER_MODE=when_thinking      # off | when_thinking | always
# FILLER_INTERVAL_S=4
# FILLERS_FIRST=["Hmm… ","Well… "]     # JSON list; persona defaults if unset
# FILLERS_REPEAT=["Bear with me… "]
# RAG_ENABLED=true
# RAG_TOP_K=4
# MAX_ANSWER_TOKENS=400

# --- Phone agent ----------------------------------------------------------------------------
# AGENT_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # stock voice; a consented clone's id later
# AGENT_VOICE_IS_CLONE=false            # true requires CONSENT.md status: granted
# AGENT_TURN_TIMEOUT_S=7                # how long a caller can pause before the agent speaks
# AGENT_SILENCE_END_CALL_S=60
# AGENT_MAX_CALL_S=1800
